# Production Environment Variables Template
# Copy this file to .env.prod and fill in your actual production values

# Google reCAPTCHA Keys (Production)
# Get your keys from: https://www.google.com/recaptcha/admin
# IMPORTANT: Use production keys, not development keys!
RECAPTCHA_SITE_KEY=your_production_site_key_here
RECAPTCHA_SECRET_KEY=your_production_secret_key_here

# Session Secret Key (Production)
# Generate a secure random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRITICAL: Must be a strong, random secret!
SESSION_SECRET_KEY=your_strong_random_secret_key_here

# Database Configuration
DATABASE_PATH=data/tejara.db

# Application Settings
ENVIRONMENT=production
DEBUG=false
